# Copy this file to api/.env and fill in real values before running the API.

# Groq API key for the AI chat assistant. Get one free at https://console.groq.com
# Leave blank to run the app with the AI assistant disabled (everything else still works).
GROK_API_KEY=

# Secret used to sign JWT auth tokens. Generate a real one for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=super-secret-key-for-portfolio

# Password for the auto-seeded "admin" account. Change this before deploying anywhere public.
ADMIN_PASSWORD=admin123

# Comma-separated list of allowed frontend origins, e.g. https://myapp.vercel.app
# Defaults to "*" (any origin) if unset.
CORS_ORIGINS=*
